{
  "name": "my-new-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8192\" next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8192\" next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed:inventory": "tsx src/scripts/seedInventory.ts",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "test:auth": "tsx src/scripts/testAuth.ts",
    "test:catalog": "tsx src/scripts/testInventoryCatalog.ts",
    "test:stock": "tsx src/scripts/testInventoryStock.ts",
    "test:csv": "tsx src/scripts/testCsvParser.ts",
    "test:roster": "tsx src/scripts/testRosterImportE2E.ts",
    "test:telegram": "tsx src/scripts/testTelegramNotifications.ts",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "build:worker": "opennextjs-cloudflare build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:roles": "tsx src/scripts/migrateInternsToMembers.ts",
    "db:studio": "drizzle-kit studio",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "preview": "opennextjs-cloudflare build && wrangler dev"
  },

  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "1.7.10",
    "@designcodeio/threeui": "^1.2.0",
    "@neondatabase/serverless": "^1.2.0",
    "@types/three": "^0.186.0",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.52.0",
    "motion": "^12.43.0",
    "next": "16.3.8",
    "ogl": "^1.0.11",
    "papaparse": "^5.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.1",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@12.9.1"
}
