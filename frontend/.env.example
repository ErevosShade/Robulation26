# Google OAuth Credentials (for club member sign-in)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Telegram Bot Integration (for inventory notifications)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_sample_token
TELEGRAM_CHANNEL_ID=-1001234567890
